                "api",
                "v1",
                "actions",
                "workspaces",
                ":workspaceId",
                "execution",
                "afm",
                "execute"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspaceId",
                  "description": "(Required) The id of the workspace."
                },
                {
                  "description": "Your GoodData Cloud organization subdomain.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
