          "name": "Execute an AFM (Analytical Foundation Model) computation.",
          "request": {
            "name": "Execute an AFM (Analytical Foundation Model) computation.",
            "description": {
              "content": "Accepts an AFM execution definition and returns a result link (resultId) that can be retrieved from the execution result endpoint.",
              "type": "text/plain"
            },
            "url": {
